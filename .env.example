CURSOR_API_KEY=
CURSOR_MODEL=gpt-5.4-mini
CURSOR_VISION_MODEL=gpt-5.4-mini
CURSOR_SYNTHESIS_MODEL=gpt-5.4-mini

# LLM provider: cursor | claude | codex | openai | subscription
LLM_PROVIDER=cursor

# Claude Code CLI (subscription via `claude login`)
CLAUDE_CLI=claude
CLAUDE_MODEL=
CLAUDE_VISION_MODEL=
CLAUDE_SYNTHESIS_MODEL=

# Codex CLI (ChatGPT/Codex subscription via `codex login`)
CODEX_CLI=codex
CODEX_MODEL=
CODEX_VISION_MODEL=
CODEX_SYNTHESIS_MODEL=
# Override ~/.codex/config.toml reasoning for pipeline steps (low | medium | high | xhigh)
CODEX_REASONING_EFFORT=medium

# OpenAI API (pay-as-you-go, used by openai provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
OPENAI_SYNTHESIS_MODEL=

# Transcription: auto | local | online
# auto uses OpenAI Whisper API when LLM_PROVIDER is openai/codex and OPENAI_API_KEY is set
TRANSCRIPTION_BACKEND=auto
OPENAI_WHISPER_MODEL=whisper-1

VISION_CONCURRENCY=5

WHISPER_MODEL=medium
WHISPER_CONCURRENCY=1
# Set WHISPER_PARALLEL_CPU=true to allow parallel chunk transcription on CPU (usually slower).
WHISPER_DEVICE=auto

INPUT_DIR=input
OUTPUT_DIR=output
WORK_DIR=work
